  "license": "ISC",
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/node": "^14.14.11",
    "@types/yargs": "^15.0.12",
    "concurrently": "^5.3.0",
    "rollup": "^2.34.2",
    "nodemon": "2.0.7"
  },
  "dependencies": {
    "glob": "^7.1.3",
    "yargs": "^16.2.0"
  }
}
