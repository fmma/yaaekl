{
  "name": "yaaekl",
  "version": "0.0.1",
  "description": "Yet Another ÆbleKage Language 🍏🥧",
  "main": "yaaekl.js",
  "bin": {
    "yaaekl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && rollup -c rollup.config.yaaekl.js",
    "watch": "concurrently \"tsc -w\" \"rollup -c rollup.config.yaaekl.js -w\"",
    "test": "node test/test.js",
    "clean": "rm -rf dist yaaekl.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmma/aeblekage-language.git"
  },
  "keywords": [
    "æ",
    "aeblekage",
    "language",
    "compiler"
  ],
